    <requisition-reason>This is intended as a workup for use in a kidney transplantation.</requisition-reason>

    <patient>
        <patient-id>Patient_440223</patient-id>

        <sample>
            <sample-id>Patient_serum_draw_412</sample-id>
            <sample-date>2024-12-11T09:00:00+01:00</sample-date>
            <sample-type>Serum</sample-type>
            <testing-laboratory>ACME Labs</testing-laboratory>

            <working-sample>
                <working-sample-id>Patient_serum_prep_123</working-sample-id>
                <treatment-date>2024-12-11T17:00:00+01:00</treatment-date>
                <testing-laboratory>ACME Labs - Subdivision</testing-laboratory>

                <!-- Several treatments were applied to this sample -->
                <treatment>
                    <method>EDTA</method>
                </treatment>
                <treatment>
                    <method>Serum Cleaning</method>
                </treatment>
                <treatment>
                    <method>Adsorption</method>
                </treatment>
                <treatment>
                    <method>Dilution</method>
                    <dilution-factor>16</dilution-factor>
                    <diluent>PBS</diluent>
                </treatment>

                <assay>
                    <assay-id>assay-1</assay-id>
                    <run-id>unique_id_from_instrument</run-id>
                    <assay-date>2025-10-23</assay-date>
                    <!-- Details about the kit -->
                    <assay-kit>
                        <assay-type>Solid Phase Assay</assay-type>
                        <assay-catalog>
                            <catalog-number>LS1A04_extended</catalog-number>
                            <lot-number>asdfasdfklj</lot-number>
                            <kit-manufacturer>One_Lambda</kit-manufacturer>
                            <kit-description>This is the extended panel for doing class I and some other stuff (Lifecodes....)</kit-description>

                        </assay-catalog>

                        <detection-reagent-catalog>
                            <catalog-number>hfjfgkhjgfj</catalog-number>
                            <lot-number>tstst</lot-number>
                            <kit-manufacturer>One_Lambda</kit-manufacturer>
                            <kit-description>This is the extended panel for doing class I and some other stuff (Lifecodes....)</kit-description>

                        </detection-reagent-catalog>


                        <interpretation-software>HLA_Fusion</interpretation-software>
                        <interpretation-software-version>4.1</interpretation-software-version>
                        <raw-MFI-divider>0.56</raw-MFI-divider>
                    </assay-kit>





                    <!-- Bead 1 is a Negative Control Bead -->
                    <target-bead-observation>
                        <bead-info>
                            <bead-id>1</bead-id>
                            <bead-type>negative-control</bead-type>
                        </bead-info>
                        <bead-raw-data>
                            <raw-MFI>78</raw-MFI>
                            <bead-count>16</bead-count>
                        </bead-raw-data>
                    </target-bead-observation>

                    <!-- Positive Control Bead -->
                    <target-bead-observation>
                        <bead-info>
                            <bead-id>2</bead-id>
                            <bead-type>positive-control</bead-type>
                        </bead-info>
                        <bead-raw-data>
                            <raw-MFI>23484</raw-MFI>
                            <bead-count>19</bead-count>
                        </bead-raw-data>
                    </target-bead-observation>

                    <!-- Bead 3 is an A*01:01 bead. -->
                    <target-bead-observation>
                        <bead-info>
                            <bead-id>3</bead-id>
                            <bead-type>target</bead-type>
                            <HLA-target-type>A*01:01</HLA-target-type>
                            <!-- can this be generalized? -->
                            <antigen-density>20000</antigen-density>
                            <relative-antigen-density>1.0900</relative-antigen-density>


                            <!--<HLA-target-serological-specificity>A1</HLA-target-serological-specificity>-->
                        </bead-info>
                        <bead-raw-data>
                            <raw-MFI>344</raw-MFI>
                            <bead-count>16</bead-count>
                        </bead-raw-data>
                        <bead-adjusted-data>
                            <adjusted-data-id>1</adjusted-data-id>
                            <adjustment-method>AD-MFI</adjustment-method>
                            <adjusted-mfi>209.7</adjusted-mfi>
                            <formula>AD is the Antigen-density-adjusted MFI.
                                Modified MFI = Raw MFI / antigen density</formula>
                            <bead-plausible>true</bead-plausible>
                        </bead-adjusted-data>
                        <bead-adjusted-data>
                            <adjusted-data-id>2</adjusted-data-id>
                            <adjustment-method>BG-MFI</adjustment-method>
                            <adjusted-mfi>302.3</adjusted-mfi>
                            <formula>"BG Adjusted" Background adjusted MFI
                                Modified MFI = Raw MFI - Negative Control working sample Bead</formula>
                            <bead-plausible>true</bead-plausible>
                        </bead-adjusted-data>
                        <bead-adjusted-data>
                            <adjusted-data-id>3</adjusted-data-id>
                            <adjustment-method>MFI/LRA</adjustment-method>
                            <mfi-ratio>3.4</mfi-ratio>
                            <formula> MFI is divided by the lowest reactive antigen.
                                MFI/LRA</formula>
                            <bead-plausible>true</bead-plausible>
                        </bead-adjusted-data>

                        <!-- Two bead interpretations, from a Software tool and a Human Interpretation -->
                        <bead-interpretation>
                            <bead-classification>Negative</bead-classification>
                            <bead-rank>2</bead-rank>
                            <mfi-threshold>500</mfi-threshold>
                            <classification-entity>Fusion Software Classification</classification-entity>
                            <interpretation-reason>Standard Threshold &lt;500 </interpretation-reason>
                        </bead-interpretation>
                        <bead-interpretation>
                            <bead-classification>Positive</bead-classification>
                            <classification-entity>Ben the Expert</classification-entity>
                            <interpretation-reason>Gut Feeling</interpretation-reason>
                        </bead-interpretation>
                        <bead-interpretation>

                            <adjusted-data-id>1</adjusted-data-id>
                            <adjusted-data-id>2</adjusted-data-id>
                            <!-- Referring to which adjusted data is referenced here -->

                            <bead-classification>Positive</bead-classification>
                            <ratio-threshold>1.7</ratio-threshold>
                            <classification-entity>Werfen Match-It</classification-entity>
                            <!-- think on a valid syntax for these formulas -->
                            <interpretation-reason>MFI/LRA ratio above ratio cut-off/threshold and raw MFI is above threshold</interpretation-reason>
                        </bead-interpretation>


                    </target-bead-observation>

                    <!-- Assay-level interpretation -->
                    <assay-interpretation>
                        <interpretation-context>Kidney Transplantation Workup</interpretation-context>
                        <interpretation-context-comment>This pre-transplant screen was performed 2 weeks before transplant to check if they had developed antibodies due to a transfusion.</interpretation-context-comment>
                        <specificities>
                            <specificities-type>Positive</specificities-type>
                            <specificities-string>A1+A2+B7+B*51:02</specificities-string>
                            <!-- <negative-specificities>A2</negative-specificities> -->
                            <!-- <questionable-specificities>DR4</questionable-specificities> -->
                        </specificities>
                        <reject-assay>false</reject-assay>

                        <!-- <reject-reason>Contamination</reject-reason> -->
                        <!-- <failure-code>3</failure-code> -->

                    </assay-interpretation>
                    
                </assay>
            </working-sample>
        </sample>

